rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure user-scoped match history:
    // Only authenticated users (including Anonymous Auth) can read, create, and manage their own matches.
    match /users/{userId}/matches/{matchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Direct collection fallback (if querying top-level matches collection):
    match /matches/{matchId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
